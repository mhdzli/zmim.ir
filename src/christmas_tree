#!/usr/bin/env python3
"""
Christmas Tree ASCII Animation
Cross-platform terminal animation for Christmas

Works on Linux, macOS, and Windows
Based on: ascii-christmas-tree by Dave Eddy
Original: https://github.com/bahamas10/xmas.ysap.sh
"""

import os
import sys
import time
import random
import shutil
from datetime import datetime

# Check if running on Windows
IS_WINDOWS = sys.platform.startswith('win')

if IS_WINDOWS:
    import msvcrt
    import ctypes
    
    # Enable ANSI escape sequences on Windows
    kernel32 = ctypes.windll.kernel32
    kernel32.SetConsoleMode(kernel32.GetStdHandle(-11), 7)
else:
    import tty
    import termios

# ANSI color codes
class Colors:
    # Reset
    RESET = '\033[0m'
    
    # Tree colors
    TREE = '\033[38;5;2m'      # green
    STAR = '\033[38;5;227m'    # yellow
    TRUNK = '\033[38;5;130m'   # brown
    
    # Lights colors (vintaglo vintage christmas lights)
    LIGHT_COLORS = [
        '\033[38;5;111m',  # cyan
        '\033[38;5;208m',  # orange
        '\033[38;5;198m',  # pink/magenta
        '\033[38;5;155m',  # green
    ]
    
    # Sign colors (from ysap theme)
    COLOR1 = '\033[38;5;87m'   # cyan
    COLOR2 = '\033[38;5;211m'  # magenta
    COLOR3 = '\033[38;5;120m'  # green
    COLOR4 = '\033[38;5;241m'  # dim
    COLOR5 = '\033[38;5;223m'  # off-white (text)
    SIGN_BORDER = '\033[38;5;130m'
    
    # Moon color
    MOON = '\033[38;5;228m'
    
    # Snowflake colors
    SNOW_COLORS = [
        '\033[0m',
        '\033[38;5;238m',
        '\033[38;5;99m',
        '\033[38;5;241m',
        '\033[38;5;96m',
    ]

# ASCII Art - Christmas Tree
TREE = """          *
         / \\
        / 0 \\
       / 1   \\
      /       \\
     /_ 2  1  _\\
      /       \\
     /  1   2  \\
    /           \\
   /   0  3  0   \\
  /_        1    _\\
   /    2        \\
  /  1   0   0    \\
 /    3         3  \\
/  2        1       \\
---------------------
         |||
        /|||\\"""

SIGN = f"""{Colors.SIGN_BORDER}  ┌───────────────────┐
{Colors.SIGN_BORDER}  │{Colors.COLOR5} Merry Christmas!{Colors.SIGN_BORDER}  │
{Colors.SIGN_BORDER}  │{Colors.COLOR5} To the North Pole{Colors.SIGN_BORDER} │
{Colors.SIGN_BORDER}  │{Colors.COLOR3} THRIVE {Colors.COLOR5} Centre {Colors.SIGN_BORDER}   │
{Colors.SIGN_BORDER}  └────────┬─┬────────┘
{Colors.SIGN_BORDER}           │ │
{Colors.SIGN_BORDER}           │ │
{Colors.SIGN_BORDER}         //└─┘\\\\
"""

MOON = """  _.._
 .' .-'`
/  /
|  |
\\  '.___.;
 '._  _.'
    ``"""

class ChristmasAnimation:
    def __init__(self, sleep_time=0.1, snow_chars='*.'):
        self.sleep_time = sleep_time
        self.snow_chars = list(snow_chars)
        self.snowflakes = []
        self.settled_snow = []  # برف‌های جمع شده پایین
        self.light_idx = 0
        self.frames = 0
        
        # Get terminal size
        self.update_terminal_size()
        
    def update_terminal_size(self):
        size = shutil.get_terminal_size()
        self.cols = size.columns
        self.lines = size.lines
        
    def clear_screen(self):
        if IS_WINDOWS:
            os.system('cls')
        else:
            print('\033[2J\033[H', end='', flush=True)
    
    def hide_cursor(self):
        print('\033[?25l', end='', flush=True)
    
    def show_cursor(self):
        print('\033[?25h', end='', flush=True)
    
    def move_cursor(self, row, col):
        print(f'\033[{row+1};{col+1}H', end='', flush=True)
    
    def colorize_tree(self, text):
        """Apply colors to the Christmas tree"""
        # Replace star
        text = text.replace(' * ', f' {Colors.STAR}*{Colors.TREE} ')
        
        # Replace lights with animated colors
        text = text.replace(' 0 ', f' {Colors.LIGHT_COLORS[self.light_idx % 4]}o{Colors.TREE} ')
        text = text.replace(' 1 ', f' {Colors.LIGHT_COLORS[(self.light_idx + 1) % 4]}o{Colors.TREE} ')
        text = text.replace(' 2 ', f' {Colors.LIGHT_COLORS[(self.light_idx + 2) % 4]}o{Colors.TREE} ')
        text = text.replace(' 3 ', f' {Colors.LIGHT_COLORS[(self.light_idx + 3) % 4]}o{Colors.TREE} ')
        
        # Color the trunk
        lines = text.split('\n')
        colored_lines = []
        for i, line in enumerate(lines):
            if i >= len(lines) - 2:  # Last 2 lines are trunk
                colored_lines.append(f'{Colors.TRUNK}{line}{Colors.RESET}')
            else:
                colored_lines.append(line)
        
        return Colors.TREE + '\n'.join(colored_lines) + Colors.RESET
    
    def draw_text_at(self, x, y, text):
        """Draw multi-line text at position"""
        lines = text.split('\n')
        for i, line in enumerate(lines):
            if y + i < self.lines and x < self.cols:
                self.move_cursor(y + i, x)
                # Truncate line if it's too long
                max_len = self.cols - x
                if len(line) > max_len:
                    line = line[:max_len]
                print(line, end='', flush=True)
    
    def update_snowflakes(self):
        """Update and draw snowflakes"""
        # Clear old snowflakes (only moving ones)
        for flake in self.snowflakes[:]:
            x, y, color, char = flake
            if 0 <= y < self.lines and 0 <= x < self.cols:
                self.move_cursor(y, x)
                print(' ', end='', flush=True)
        
        # Move snowflakes down
        new_snowflakes = []
        for flake in self.snowflakes:
            x, y, color, char = flake
            y += 1
            if y < self.lines - 1:  # اگه به آخر نرسیده ادامه بده
                new_snowflakes.append((x, y, color, char))
            else:
                # snow is down save it
                self.settled_snow.append((x, self.lines - 1, color, char))
        
        # Add new snowflake
        x = random.randint(0, self.cols - 1)
        color = random.choice(Colors.SNOW_COLORS)
        char = random.choice(self.snow_chars)
        new_snowflakes.append((x, 0, color, char))
        
        # Draw settled snow
        for flake in self.settled_snow:
            x, y, color, char = flake
            if 0 <= y < self.lines and 0 <= x < self.cols:
                self.move_cursor(y, x)
                print(f'{color}{char}{Colors.RESET}', end='', flush=True)
        
        # Draw moving snowflakes
        for flake in new_snowflakes:
            x, y, color, char = flake
            if 0 <= y < self.lines and 0 <= x < self.cols:
                self.move_cursor(y, x)
                print(f'{color}{char}{Colors.RESET}', end='', flush=True)
        
        self.snowflakes = new_snowflakes
    
    def run(self):
        """Main animation loop"""
        try:
            self.hide_cursor()
            self.clear_screen()
            
            while True:
                self.update_terminal_size()
                
                # Calculate positions
                tree_lines = TREE.split('\n')
                tree_height = len(tree_lines)
                tree_width = 21
                
                sign_lines = SIGN.split('\n')
                sign_height = len(sign_lines)
                
                moon_lines = MOON.split('\n')
                moon_height = len(moon_lines)
                
                # Positions
                tree_x = 5
                tree_y = self.lines - tree_height - 1
                
                sign_x = 5 + tree_width + 5
                sign_y = self.lines - sign_height - 1
                
                moon_x = self.cols - 20
                moon_y = 3
                
                # Update snowflakes first
                self.update_snowflakes()
                
                # Draw tree
                tree_text = self.colorize_tree(TREE)
                self.draw_text_at(tree_x, tree_y, tree_text)
                
                # Draw sign
                self.draw_text_at(sign_x, sign_y, SIGN)
                
                # Draw moon
                if moon_x > 0:
                    moon_text = Colors.MOON + MOON + Colors.RESET
                    self.draw_text_at(moon_x, moon_y, moon_text)
                
                # Update animation indices
                self.frames += 1
                if self.frames % 10 == 0:
                    self.light_idx += 1
                
                time.sleep(self.sleep_time)
                
        except KeyboardInterrupt:
            pass
        finally:
            self.show_cursor()
            self.clear_screen()

def main():
    """Main entry point"""
    import argparse
    
    parser = argparse.ArgumentParser(
        description='Christmas Tree ASCII Animation - Cross-platform terminal celebration',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python3 christmas_tree.py
  python3 christmas_tree.py -s 0.2
  python3 christmas_tree.py -c "❄*+."
  
Credits:
  - Original bash script by Dave Eddy
  - Moon ascii art by jgs (asciiart.eu)
  - Python port: Cross-platform version
        """
    )
    parser.add_argument(
        '-s', '--speed',
        type=float,
        default=0.3,
        help='Animation speed in seconds (default: 0.3)'
    )
    parser.add_argument(
        '-c', '--chars',
        type=str,
        default='*.',
        help='Characters to use for snowflakes (default: "*.")'
    )
    
    args = parser.parse_args()
    
    print("Starting Christmas Tree Animation...")
    print("Press Ctrl+C to exit")
    time.sleep(1)
    
    animation = ChristmasAnimation(sleep_time=args.speed, snow_chars=args.chars)
    animation.run()

if __name__ == '__main__':
    main()
